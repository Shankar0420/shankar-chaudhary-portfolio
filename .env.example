# ===================================================================
# Shankar Chaudhary Portfolio - Environment Variables Configuration
# ===================================================================

# --- ADMIN CREDENTIALS & INITIAL SETUP ---
# Registered Owner Mobile (hardcoded single-owner security requirement)
ADMIN_MOBILE=9905340058

# Optional: Seed initial admin password directly via environment.
# If left empty, navigate to http://localhost:5173/admin to complete one-time setup.
INITIAL_ADMIN_PASSWORD=

# Optional: Emergency recovery key override (for resetting password if key was lost)
# ADMIN_RECOVERY_KEY=

# JWT Secret Key (min 32 characters for HMAC-SHA256)
JWT_SECRET=4f8b9e2c6a1d3f5e7a9b0c2d4e6f8a1b3c5d7e9f0a2b4c6d8e0f1a3b5c7d9e1f

# --- SERVER & PORTS ---
SERVER_PORT=8080
VITE_PORT=5173

# --- DATABASE SELECTION ---
# Default: Zero-configuration persistent H2 (embedded, zero dependencies required)
# To use MariaDB or MySQL, set SPRING_PROFILES_ACTIVE=mysql and provide database credentials below:
# SPRING_PROFILES_ACTIVE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=portfolio_db
# DB_USER=portfolio_user
# DB_PASSWORD=your_secure_password

